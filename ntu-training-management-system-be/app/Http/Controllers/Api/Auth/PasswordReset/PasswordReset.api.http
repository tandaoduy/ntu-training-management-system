@baseUrl = http://localhost:8000/api
@captchaId = REPLACE_WITH_CAPTCHA_ID
@captchaCode = REPLACE_WITH_CAPTCHA_CODE
@resetToken = REPLACE_WITH_RESET_TOKEN
@resetEmail = user@example.com

### Get captcha
GET {{baseUrl}}/auth/forgot-password/captcha
Accept: application/json

### Check email
POST {{baseUrl}}/auth/check-email
Content-Type: application/json
Accept: application/json

{
  "email": "{{resetEmail}}"
}

### Validation case invalid email, expect 422
POST {{baseUrl}}/auth/check-email
Content-Type: application/json
Accept: application/json

{
  "email": "not-email"
}

### Forgot password
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json
Accept: application/json

{
  "identifier": "65131708",
  "captcha_id": "{{captchaId}}",
  "captcha_code": "{{captchaCode}}"
}

### Verify reset token
POST {{baseUrl}}/auth/verify-reset-token
Content-Type: application/json
Accept: application/json

{
  "token": "{{resetToken}}",
  "email": "{{resetEmail}}"
}

### Reset password
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json
Accept: application/json

{
  "token": "{{resetToken}}",
  "email": "{{resetEmail}}",
  "password": "123456789",
  "password_confirmation": "123456789"
}

### Validation case password confirmation mismatch, expect 422
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json
Accept: application/json

{
  "token": "{{resetToken}}",
  "email": "{{resetEmail}}",
  "password": "123456789",
  "password_confirmation": "different"
}
