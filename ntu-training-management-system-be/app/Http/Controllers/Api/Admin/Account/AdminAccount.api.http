@baseUrl = http://localhost:8000/api
@authToken = REPLACE_WITH_ADMIN_TOKEN
@accountId = 1

### Login admin va copy access_token vao @authToken
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "username": "Admin",
  "password": "Admin@123456789"
}

### Danh sach tai khoan
GET {{baseUrl}}/admin/accounts
Authorization: Bearer {{authToken}}
Accept: application/json

### Loc tai khoan sinh vien
GET {{baseUrl}}/admin/accounts?role=student
Authorization: Bearer {{authToken}}
Accept: application/json

### Danh muc don vi va lop cho form sinh vien
GET {{baseUrl}}/admin/accounts/student-catalog
Authorization: Bearer {{authToken}}
Accept: application/json

### Danh sach don vi
GET {{baseUrl}}/admin/don-vis
Authorization: Bearer {{authToken}}
Accept: application/json

### Danh sach lop hanh chinh
GET {{baseUrl}}/admin/lops
Authorization: Bearer {{authToken}}
Accept: application/json

### Tao lop hanh chinh
POST {{baseUrl}}/admin/lops
Content-Type: application/json
Authorization: Bearer {{authToken}}
Accept: application/json

{
  "don_vi_id": 1,
  "lop_hoc_phan": "65.QTKD-1 (65.QTKD-1)",
  "ma_khoi": "65.QTKD"
}

### Xoa lop hanh chinh
DELETE {{baseUrl}}/admin/lops/1
Authorization: Bearer {{authToken}}
Accept: application/json

### Tao tai khoan tong quat
POST {{baseUrl}}/admin/accounts
Content-Type: application/json
Authorization: Bearer {{authToken}}
Accept: application/json

{
  "role": "student",
  "username": "65139999",
  "password": "123456789",
  "name": "Sinh viên Test",
  "email": "student.test@ntu.edu.vn",
  "phone": "0900000000"
}

### Tao sinh vien
POST {{baseUrl}}/admin/accounts/students
Content-Type: application/json
Authorization: Bearer {{authToken}}
Accept: application/json

{
  "username": "65138888",
  "password": "123456789",
  "ten_sinh_vien": "Nguyễn Văn Test",
  "email": "nguyenvantest.65cntt@ntu.edu.vn",
