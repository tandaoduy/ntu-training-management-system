  "ten_don_vi": "Khoa Công nghệ thông tin",
  "ten_nganh_hoc": "Công nghệ thông tin",
  "he_dao_tao": "Chính quy",
  "so_cccd": "056205004525",
  "ngay_cap_cccd": "2021-11-11",
  "noi_cap_cccd": "Cục cảnh sát QLHC về TTXH",
  "ho_khau_tinh_thanh_pho": "Khánh Hòa",
  "ho_khau_quan_huyen": "Thành phố Nha Trang",
  "que_quan_tinh_thanh_pho": "Khánh Hòa",
  "que_quan_quan_huyen": "Thành phố Nha Trang",
  "que_quan": "38/17/B1 Lê Hồng Phong",
  "dan_toc": "Kinh",
  "ton_giao": "Không"
